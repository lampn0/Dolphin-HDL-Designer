# ---------------------------------------------------------------------------------------------
# HDL Studio - files git must never track
# ---------------------------------------------------------------------------------------------

# Python byte code and local virtual environments
__pycache__/
*.pyc
.venv/
venv/

# Packaging output (PyInstaller, see resources/scripts/HDLStudio.spec)
build/
dist/
*.zip

# Editor settings
.vscode/
.idea/

# Files HDS / HDL Studio create next to a design (locks, caches, backups)
*.lck
*.bak
.hdlsidedata/
.xrf/
*.cache.dat

# Test output: screenshots, scratch projects, HDS reference data (holds design content of
# the real project), comparison results. All of it is regenerated by the test scripts.
tests/gui/out/
tests/hds_gui/out/
tests/hds_compare/out/
tests/hds_compare/reference/
tests/hds_compare/results/
tests/hds_sync/work/
tests/hds_sync/results/
